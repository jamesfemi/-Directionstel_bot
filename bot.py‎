import os
import logging
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

WELCOME_MESSAGE = """ברוכים הבאים 👋

תודה שפנית אלינו!
אנחנו כאן כדי לעזור לך למצוא את הפתרון המתאים לצרכים שלך.

אתה יכול:
• לשאול כל שאלה
• לקבל מידע נוסף
• לבצע הזמנה או לבקש תמיכה

התחיל כאן:
https://t.me/m/lreqLDxBYjA0

או פשוט לשלוח הודעה - נענה בקרוב ✅"""

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(WELCOME_MESSAGE)
    logger.info(f"User {update.effective_user.id} started the bot")

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("תודה על הודעתך! נענה בהקדם האפשרי. ✅")

def main():
    token = os.getenv('TELEGRAM_BOT_TOKEN')
    if not token:
        logger.error("TELEGRAM_BOT_TOKEN not set!")
        return
    
    app = Application.builder().token(token).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    
    logger.info("Bot started successfully!")
    app.run_polling()

if __name__ == '__main__':
    main()
